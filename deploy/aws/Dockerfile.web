FROM node:22.23.3-slim AS build

RUN corepack enable
WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web apps/web
COPY packages packages

RUN pnpm install --frozen-lockfile --filter "@fretflow/web..."

ARG VITE_API_URL=https://fretflow.iliasai.com
ARG VITE_SOCIAL_LOGIN=
ARG VITE_POSTHOG_KEY=
ARG VITE_POSTHOG_HOST=
ARG VITE_SENTRY_DSN=

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SOCIAL_LOGIN=$VITE_SOCIAL_LOGIN
ENV VITE_POSTHOG_KEY=$VITE_POSTHOG_KEY
ENV VITE_POSTHOG_HOST=$VITE_POSTHOG_HOST
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN

RUN pnpm --filter @fretflow/web build
# Files copied from a checkout with restrictive modes would 403 in Nginx.
RUN chmod -R a+rX apps/web/dist

FROM nginx:alpine
COPY deploy/aws/web-nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/aws/web-security-headers.conf /etc/nginx/snippets/web-security-headers.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
EXPOSE 80

