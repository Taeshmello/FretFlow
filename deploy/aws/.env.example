# 백엔드 배포 스크립트가 읽는 운영 환경변수 목록.
# 이 파일은 "이름만" 있는 예시다. 실제 값은 넣지 않는다.
#
# EC2 에서:
#   cd ~/fretflow/deploy/aws
#   cp .env.example .env && chmod 600 .env && vi .env
# .env 는 Git 에 올라가지 않는다(.gitignore 의 .env 규칙).
#
# 주의: 값에 "$" 를 쓰지 않는다(Compose 가 변수로 해석한다).
# 비밀번호는 openssl rand -hex 32 처럼 hex 로 만든다. base64 의 + / = 는
# DATABASE_URL 안에서 깨진다.

# --- 공개 주소 ---------------------------------------------------------------
# 이번 백엔드 단계에서도 인증 쿠키·CORS 기준으로 필요하다. Nginx/TLS가
# 준비되기 전에는 외부 접속이 되지 않아도 이 최종 도메인 값은 유지한다.
PUBLIC_ORIGIN=https://fretflow.iliasai.com
BETTER_AUTH_URL=https://fretflow.iliasai.com
WEB_ORIGIN=https://fretflow.iliasai.com

# --- 실행 --------------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# 호스트 Nginx 가 Cloudflare 기준 실제 IP 로 덮어쓰는 헤더. 바꾸지 않는다.
CLIENT_IP_HEADER=x-real-ip

# --- PostgreSQL --------------------------------------------------------------
# 같은 EC2 에 DB 컨테이너를 띄울 때만 COMPOSE_PROFILES=db 로 둔다.
# RDS 를 쓰면 비워 두고 DATABASE_URL 을 RDS 주소로 넣는다.
COMPOSE_PROFILES=db
# DB 이름은 fretflow 로 고정한다. 기존 회사 서비스 DB 와 완전히 별개다.
POSTGRES_DB=fretflow
# 기존 서비스 계정을 재사용하지 않는다. FretFlow 전용 계정을 새로 만든다.
POSTGRES_USER=
# 생성해서 넣는다: openssl rand -hex 32
POSTGRES_PASSWORD=
# DB 컨테이너: postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/fretflow
# RDS:        postgres://<앱계정>:<비밀번호>@<RDS 엔드포인트>:5432/fretflow?sslmode=require
DATABASE_URL=
# 스키마 변경 전용 계정(RDS 에서 권장). 비우면 DATABASE_URL 로 마이그레이션한다.
# MIGRATION_DATABASE_URL=

# --- 인증 (Better Auth) -------------------------------------------------------
# 세션 서명 키. 32자 이상. 서버에서 생성: openssl rand -base64 48
# 비워 두면 API 컨테이너가 뜨지 않는다(의도된 동작).
# 한 번 정하면 바꾸지 않는다. 바꾸면 모든 사용자가 로그아웃된다.
BETTER_AUTH_SECRET=
# Google 로그인. 둘 다 넣거나 둘 다 비운다. 비우면 Google 로그인만 꺼진다.
# 콜백 URI: https://fretflow.iliasai.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 웹의 Google 버튼 표시. Google 키를 넣었을 때만 google 로 둔다.
VITE_SOCIAL_LOGIN=

# --- 이메일 (로그인 링크) -----------------------------------------------------
# Resend 호환 API. 키가 없으면 API 가 뜨지 않는다.
EMAIL_FROM=FretFlow <login@iliasai.com>
EMAIL_PROVIDER_API_KEY=
# EMAIL_PROVIDER_URL=https://api.resend.com/emails

# --- Cloudflare R2 (선택: 음원 클라우드 동기화) -------------------------------
# false이면 녹음은 각 브라우저에만 저장되며 아래 S3 값은 필요하지 않다.
# R2를 준비한 뒤 서버와 웹을 모두 true로 바꾸면 기기 간 음원 동기화가 켜진다.
AUDIO_STORAGE_ENABLED=false
VITE_AUDIO_CLOUD_SYNC=false
# R2 대시보드의 계정 ID를 넣는다. 버킷 자체는 공개하지 않는다.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=fretflow-audio
S3_FORCE_PATH_STYLE=false
# R2 PutObject는 full-object SHA-256 체크섬을 지원하지 않는다.
S3_UPLOAD_CHECKSUM=none
# R2 > Manage R2 API Tokens에서 이 버킷에만 Object Read & Write 권한을
# 가진 토큰을 만들고 표시되는 Access Key ID / Secret Access Key를 넣는다.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- 호스트 포트 -------------------------------------------------------------
# 기존 서비스(80 / 8000 / 5432)와 CareLog(8081)와 겹치면 안 된다.
# 둘 다 127.0.0.1 에만 열린다. PostgreSQL 은 호스트 포트를 쓰지 않는다.
FRETFLOW_API_HOST_PORT=3100
# 미래 프론트엔드 배포용이며 deploy.sh backend는 읽거나 사용하지 않는다.
FRETFLOW_WEB_HOST_PORT=8082

# --- 기타 --------------------------------------------------------------------
# 이미지 태그. deploy.sh 는 Git 커밋 해시로 태그한다.
# 롤백 명령은 BACKEND-DEPLOYMENT.txt를 따른다.
FRETFLOW_IMAGE_TAG=latest
# 선택
# SENTRY_DSN=
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=
# AUDIO_QUOTA_BYTES=2147483648
# AUDIO_MAX_PENDING=20
