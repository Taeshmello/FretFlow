{
  "name": "@fretflow/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types --disable-warning=ExperimentalWarning --import ./src/runtime/register.ts src/index.ts",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./src/runtime/register.ts src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./src/runtime/register.ts src/db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1142.0",
    "@aws-sdk/s3-request-presigner": "3.1142.0",
    "@fretflow/score-model": "workspace:*",
    "@hono/node-server": "2.1.1",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.10",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.6.3",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
