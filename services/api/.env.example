# Copy to .env and fill in. Never commit .env (BACKEND.md §3).
# Values below match docker-compose.yml for local development.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# App role. In production grant it DML only (SELECT/INSERT/UPDATE/DELETE).
DATABASE_URL=postgres://fretflow:fretflow@localhost:5432/fretflow
# Optional. Role used only by src/db/migrate.ts (DDL). Production: a separate
# role that owns the schema. Unset = DATABASE_URL.
# MIGRATION_DATABASE_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# CORS / trusted origins, comma separated
WEB_ORIGIN=http://localhost:5180

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EMAIL_FROM="FretFlow <login@example.com>"
EMAIL_PROVIDER_API_KEY=
# Optional. Resend-compatible JSON endpoint (default: https://api.resend.com/emails)
# EMAIL_PROVIDER_URL=

# Local: MinIO from docker-compose. Production: Cloudflare R2.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fretflow-audio
S3_ACCESS_KEY_ID=fretflow
S3_SECRET_ACCESS_KEY=fretflow-dev-secret
S3_FORCE_PATH_STYLE=true

SENTRY_DSN=

# Header your host sets to the real client IP, OVERWRITING any client-sent value
# (e.g. fly-client-ip). Required when NODE_ENV=production; x-forwarded-for is refused.
# Unset in development = socket address. Used for the sign-in rate limit.
# CLIENT_IP_HEADER=

# Optional per-user audio limits (defaults: 2GB, 20 unfinished uploads)
# AUDIO_QUOTA_BYTES=2147483648
# AUDIO_MAX_PENDING=20
