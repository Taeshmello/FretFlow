# Public values only: everything here ends up in the browser bundle.

# services/api origin. Empty = local mode (this browser only, no sign-in).
VITE_API_URL=

# Social sign-in buttons to switch on once the provider is set up on the server,
# comma separated: google,apple. Empty = both buttons show as "Soon" (email only).
VITE_SOCIAL_LOGIN=

# Analytics and error reporting. Empty = nothing is sent.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_SENTRY_DSN=
